{
  "de": {
    "description": "Zentrale Konfigurationsdatei für die GMCounter-Anwendung. Stellt Konstanten und Standardwerte für die gesamte Anwendung bereit.",
    "application": {
      "name": "GM-Counter_GUI",
      "version": "2.1.0",
      "author": "C. Kessler, H. Celik",
      "window_mode": "maximized"
    },
    "debug": {
      "level_default": "verbose"
    },
    "connection": {
      "max_retry_attempts": 8,
      "initial_retry_delay_ms": 500,
      "max_retry_delay_ms": 16000,
      "backoff_factor": 2.0
    },
    "plot": {
      "max_points": 300,
      "x_label": "Ereignis k",
      "y_label": "Zeit / µs"
    },
    "histogram": {
      "bin_size": 10,
      "x_label": "Zeit / µs",
      "y_label": "Anzahl Ereignisse"
    },
    "timers": {
      "control_update_interval": 1000,
      "statistics_update_interval": 2000,
      "acquisition_timer_interval": 100,
      "gui_update_interval": 200
    },
    "acquisition": {
      "_comment": "ticks_per_us MUST equal the firmware's TICKS_PER_US (config.h). The firmware sends inter-event deltas as raw timer ticks; the host divides by this to get microseconds. RA4M1 core clock = 48 MHz -> 48 ticks/µs (~20.8 ns resolution).",
      "ticks_per_us": 48,
      "read_chunk_bytes": 8192,
      "read_timeout_ms": 50,
      "_comment2": "first_delta_is_from_start: if true, the firmware emits start->first-pulse as the first packet (no '+1' seeding needed). Default false: host assumes pure inter-event gaps and seeds event #1 at t=0.",
      "first_delta_is_from_start": false
    },
    "data_controller": {
      "max_history_size": 1000,
      "high_speed_mode": {
        "batch_threshold": 100,
        "batch_history": 5
      }
    },
    "save": {
      "tk_designation": "Radioaktivität",
      "base_folder": "GMCounter"
    },
    "gm_counter": {
      "demo_mode": true,
      "default_arduino": "UNO",
      "default_voltage": 500,
      "voltage_warning_threshold": 650,
      "count_time_map": {
        "0": 999,
        "1": 1,
        "2": 10,
        "3": 60,
        "4": 100,
        "5": 300
      },
      "label_map": {
        "repeat_on": "Wiederholung",
        "repeat_off": "Einzel",
        "auto_on": "Automatik",
        "auto_off": "Manuell"
      }
    },
